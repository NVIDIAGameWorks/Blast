    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Attach (windows-x86_64/linux-x86_64)",
            "type": "python",
            "request": "attach",
            "port": 3000,
        },
        {
            "name": "UnitTests (debug, windows-x86_64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/windows-x86_64/debug/blast-sdk/bin/UnitTests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "UnitTests (release, windows-x86_64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/windows-x86_64/release/blast-sdk/bin/UnitTests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "UnitTests (debug, linux-x86_64)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/_build/linux-x86_64/debug/blast-sdk/bin/UnitTests",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DISPLAY": ":1"
            },
            "console": "internalConsole",
        },
        {
            "name": "UnitTests (release, linux-x86_64)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/_build/linux-x86_64/release/blast-sdk/bin/UnitTests",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DISPLAY": ":1"
            },
            "console": "internalConsole",
        },
    ]
}
